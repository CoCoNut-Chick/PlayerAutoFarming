{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"CoCoNutChick"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/${id}/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.autofarm.AutoFarm"
		],
		"client": [
			"com.autofarm.client.AutoFarmClient"
		],
		"modmenu": [
			"com.autofarm.client.compat.AutoFarmModMenu"
		]
	},
	"mixins": [
		"autofarm.mixins.json",
		{
			"config": "autofarm.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${javaMajor}",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*"
	}
}